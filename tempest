#!/usr/bin/env php
<?php
if (!ini_get('opcache.enable_cli') && ($_SERVER['argv'][1] ?? null) === 'data:parse') {
    pcntl_exec(PHP_BINARY, [
        '-dopcache.enable_cli=1',
        '-dopcache.jit=1255',
        '-dopcache.jit_buffer_size=64M',
        '-dopcache.jit_hot_loop=1',
        '-dopcache.jit_hot_func=1',
        ...$_SERVER['argv'],
    ]);
}

$argv = $_SERVER['argv'];

if (($argv[1] ?? null) === 'data:parse') {
    require __DIR__ . '/app/Parser.php';

    $inputPath = __DIR__ . '/data/data.csv';
    $outputPath = __DIR__ . '/data/data.json';

    for ($i = 2; $i < count($argv); $i++) {
        $arg = $argv[$i];
        if (str_starts_with($arg, '--input-path=')) {
            $inputPath = trim(substr($arg, 13), '"\'');
        } elseif (str_starts_with($arg, '--output-path=')) {
            $outputPath = trim(substr($arg, 14), '"\'');
        }
    }

    \App\Parser::parse($inputPath, $outputPath);
    return;
}

use Tempest\Console\ConsoleApplication;

require_once getcwd() . '/vendor/autoload.php';

ConsoleApplication::boot(loadBuiltInCommands: false)->run();

exit;
